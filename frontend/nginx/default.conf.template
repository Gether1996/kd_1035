# Rendered by the nginx image at start-up (envsubst): ${SITE_URL} comes from the compose environment.

map $http_x_forwarded_proto $kd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Public origin for canonical/hreflang/og tags, sitemap and robots.txt
map "${SITE_URL}" $kd_origin {
    ""      $kd_proto://$http_host;
    default "${SITE_URL}";
}

# Link-preview bots do not run JavaScript, so a guide page (rendered in the browser) would show them only the generic
# site meta; they get the guide's own title and intro from Django instead. Search crawlers (Googlebot, Bingbot,
# Applebot) are left out on purpose: they render the app themselves.
map $http_user_agent $kd_link_bot {
    default 0;
    ~*(discordbot|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot|whatsapp|linkedinbot|skypeuripreview|redditbot|mastodon|embedly|pinterest) 1;
}

# Access log without the visitor's IP address (the privacy page promises it). Both servers below use it; the
# image's default `main` format is replaced, not doubled, because access_log is set on the server level.
log_format kd_noip '[$time_local] "$request" $status $body_bytes_sent "$http_user_agent" $request_time';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 20m;

    access_log /var/log/nginx/access.log kd_noip;
    # probes for missing files would put the client IP into the error log
    log_not_found off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain text/xml application/javascript application/json application/xml
               application/manifest+json image/svg+xml;

    # prerendered pages and robots.txt carry the __SITE_ORIGIN__ placeholder
    sub_filter_types text/plain;
    sub_filter '__SITE_ORIGIN__' $kd_origin;
    sub_filter_once off;

    include /etc/nginx/snippets/security-headers.conf;

    # Django: API, admin and its static files, sitemap with all guides
    location ~ ^/(api|admin|static)/|^/sitemap\.xml$ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $kd_proto;
        proxy_read_timeout 60s;
    }

    location = /admin {
        return 301 /admin/;
    }

    # files uploaded through the admin (shared volume); ^~ so the image rule below does not take them over
    location ^~ /uploads/ {
        alias /srv/uploads/;
        expires 7d;
    }

    # Angular build output with hashed names – cache forever
    location ~* ^/(?:main|polyfills|styles|chunk)-[A-Z0-9]+\.(?:js|css)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /media/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(?:svg|png|jpe?g|webp|avif|ico|webmanifest)$ {
        expires 7d;
    }

    # single guides are rendered in the browser from the app shell; link-preview bots get Django's
    # /api/link-preview/ page with the guide's Open Graph tags (same address, so robots.txt applies as usual)
    location ~ ^/(cz/)?navody/[^/]+/[^/]+/?$ {
        if ($kd_link_bot) {
            rewrite ^/(.*)$ /api/link-preview/$1 last;
        }
        try_files /index.csr.html =404;
        add_header Cache-Control "no-cache";
        add_header Vary "User-Agent";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # prerendered pages: /, /o-nas, /navody/vybava, /cz, /cz/o-nas …
    location / {
        try_files $uri $uri/index.html =404;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # unknown address → app shell with a real 404 status; the router keeps the address and shows the 404 page
    # in the language of the URL (/cz/… Czech)
    error_page 404 /index.csr.html;
}

# www.kd1035.eu → kd1035.eu: one canonical address for visitors and Google
server {
    listen 80;
    server_name ~^www\.(?<apex>.+)$;
    server_tokens off;
    access_log /var/log/nginx/access.log kd_noip;
    return 301 $kd_proto://$apex$request_uri;
}
