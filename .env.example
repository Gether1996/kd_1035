# Copy to `.env` and fill in real values. `.env` is git-ignored – upload it to the server manually.

# --- Django ---------------------------------------------------------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=change-me
# 1 = local development, 0 = production server
DJANGO_DEBUG=0
# Comma-separated domains the site is served on
DJANGO_ALLOWED_HOSTS=kd1035.eu,www.kd1035.eu,localhost,127.0.0.1
# Full origins (with scheme) allowed to POST forms, e.g. the admin login
DJANGO_CSRF_TRUSTED_ORIGINS=https://kd1035.eu
# 1 = cookies only over HTTPS (keep 1 on the server once HTTPS works)
DJANGO_SECURE_COOKIES=1

# Admin account created automatically on first start (if it does not exist yet)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Website ----------------------------------------------------------------
# Public address without trailing slash – canonical URLs, sitemap, og:image, Discord avatar, Discord login redirect
SITE_URL=https://kd1035.example.com
# Host port the website listens on (production compose)
WEB_PORT=8080

# --- Discord event notifications -----------------------------------------
# Discord: Server Settings → Integrations → Webhooks → New Webhook → pick channel → Copy Webhook URL
# Production webhook only on the server. In a dev .env use a test channel (the dev database travels to every PC
# through git and each dev worker would post the event reminders too). Empty = reminders are not planned.
DISCORD_WEBHOOK_URL=
# Default role pinged with notifications (Developer Mode → right-click role → Copy Role ID). Empty = no ping.
# A kingdom event or a single notification can set its own role ID instead.
DISCORD_EVENT_ROLE_ID=

# --- Sign in with Discord (player accounts) --------------------------------
# Login collects personal data: do NOT set these on the production server before the privacy page is deployed.
# 1. https://discord.com/developers/applications → New Application (e.g. "KD 1035")
# 2. OAuth2 → copy Client ID → DISCORD_CLIENT_ID; Reset Secret → copy → DISCORD_CLIENT_SECRET (only here, never in git)
# 3. OAuth2 → Redirects → add both, exactly like this (with the trailing slash):
#      http://localhost:4200/api/auth/discord/callback/
#      https://<production domain>/api/auth/discord/callback/
#    The site sends SITE_URL + /api/auth/discord/callback/ – it must match a registered redirect.
#    Locally SITE_URL may stay empty: the address from the browser (http://localhost:4200) is used.
# 4. Nothing else to tick (no bot): the site asks only for "identify" = ID, name, avatar (no e-mail, no servers).
# Both empty = login is switched off (no login button on the site).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Database backups -------------------------------------------------------
# Host folder for backups (relative to docker-compose.yml)
BACKUP_PATH=./backups
BACKUP_INTERVAL_DAYS=7
# How many backups to keep (older ones are deleted)
BACKUP_KEEP=8
