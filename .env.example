# Copy to `.env` and fill in real values. `.env` is git-ignored – upload it to the server manually.

# --- Django ---------------------------------------------------------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=change-me
# 1 = local development, 0 = production server
DJANGO_DEBUG=0
# Comma-separated domains the site is served on
DJANGO_ALLOWED_HOSTS=kd1035.eu,www.kd1035.eu,localhost,127.0.0.1
# Full origins (with scheme) allowed to POST forms, e.g. the admin login
DJANGO_CSRF_TRUSTED_ORIGINS=https://kd1035.eu
# 1 = cookies only over HTTPS (keep 1 on the server once HTTPS works)
DJANGO_SECURE_COOKIES=1
# Reverse proxies in front of Django: nginx in the `web` container + the HTTPS proxy on the server (Caddy, Nginx
# Proxy Manager, Traefik…) = 2. Without an HTTPS proxy in front of `web` (e.g. a local test on :9005) use 1.
# Used to find the visitor's IP for the Discord login limit (20 sign-ins per hour per IP).
DJANGO_NUM_PROXIES=2

# Admin account created automatically on first start (if it does not exist yet)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Website ----------------------------------------------------------------
# Public address without trailing slash – canonical URLs, sitemap, og:image, Discord avatar, Discord login redirect
SITE_URL=https://kd1035.eu
# Host port the website listens on (production compose)
WEB_PORT=9005

# --- Discord event notifications -----------------------------------------
# Discord: Server Settings → Integrations → Webhooks → New Webhook → pick channel → Copy Webhook URL
# Production webhook only on the server. In a dev .env use a test channel (the dev database travels to every PC
# through git and each dev worker would post the event reminders too). Empty = reminders are not planned.
DISCORD_WEBHOOK_URL=
# Default role pinged with notifications (Developer Mode → right-click role → Copy Role ID). Empty = no ping.
# A kingdom event or a single notification can set its own role ID instead.
DISCORD_EVENT_ROLE_ID=

# --- Sign in with Discord (player accounts) --------------------------------
# Login collects personal data: set these on the production server only once the privacy page (/ochrana-udajov,
# frontend/src/app/pages/privacy) is deployed – it lists exactly what the site stores.
# 1. https://discord.com/developers/applications → New Application (e.g. "KD 1035")
# 2. OAuth2 → copy Client ID → DISCORD_CLIENT_ID; Reset Secret → copy → DISCORD_CLIENT_SECRET (only here, never in git)
# 3. OAuth2 → Redirects → add both, exactly like this (with the trailing slash):
#      http://localhost:4200/api/auth/discord/callback/
#      https://kd1035.eu/api/auth/discord/callback/
#    The site sends SITE_URL + /api/auth/discord/callback/ – it must match a registered redirect.
#    Locally SITE_URL may stay empty: the address from the browser (http://localhost:4200) is used.
# 4. Nothing else to tick for the sign-in: the site asks only for "identify" = ID, name, avatar (no e-mail, no
#    servers). The bot below (event reminders) is a separate, optional step in the same application.
# Both empty = login is switched off (no login button on the site).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord IDs (comma-separated) that become superusers when they sign in with Discord – Gether: 245662824171438090.
# Removing an ID later does not take the rights away; do that in the admin (Users → Superuser status).
DISCORD_ADMIN_IDS=

# --- Personal event reminders (players pick events and times on /ucet) ------------
# Sent by the worker. Each channel stays off while its keys are empty – nothing breaks without them.
# Discord private messages come from a bot of the SAME application as the sign-in above:
# 1. https://discord.com/developers/applications → the application with DISCORD_CLIENT_ID → Bot
# 2. Reset Token → copy → DISCORD_BOT_TOKEN (only here, never in git). No privileged intents are needed.
# 3. Invite the bot to the kingdom's Discord server (it needs no permissions), replace <DISCORD_CLIENT_ID>:
#      https://discord.com/oauth2/authorize?client_id=<DISCORD_CLIENT_ID>&scope=bot&permissions=0
#    A player gets the message only while they are on that server and allow DMs from its members.
DISCORD_BOT_TOKEN=
# Browser and phone notifications (web push, needs HTTPS on the server): generate the keys once and paste the lines:
#   docker compose exec -u app backend python manage.py generate_vapid_keys
# Keep them: a new key pair switches off the notifications players already turned on (they would have to turn
# them on again). The private key only here, never in git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: the site address or mailto:you@example.com (Apple refuses localhost)
VAPID_SUBJECT=https://kd1035.eu

# --- Database backups -------------------------------------------------------
# Host folder for backups (relative to docker-compose.yml)
BACKUP_PATH=./backups
BACKUP_INTERVAL_DAYS=7
# How many backups to keep (older ones are deleted). The privacy page promises deleted data leaves the backups
# within BACKUP_KEEP × BACKUP_INTERVAL_DAYS = 8 weeks – change the page together with these two values.
BACKUP_KEEP=8
