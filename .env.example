# Copy to `.env` and fill in real values. `.env` is git-ignored – upload it to the server manually.

# --- Django ---------------------------------------------------------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=change-me
# 1 = local development, 0 = production server
DJANGO_DEBUG=0
# Comma-separated domains the site is served on
DJANGO_ALLOWED_HOSTS=kd1035.example.com,localhost,127.0.0.1
# Full origins (with scheme) allowed to POST forms, e.g. the admin login
DJANGO_CSRF_TRUSTED_ORIGINS=https://kd1035.example.com
# 1 = cookies only over HTTPS (keep 1 on the server once HTTPS works)
DJANGO_SECURE_COOKIES=1

# Admin account created automatically on first start (if it does not exist yet)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Website ----------------------------------------------------------------
# Public address without trailing slash – canonical URLs, sitemap, og:image, Discord avatar
SITE_URL=https://kd1035.example.com
# Host port the website listens on (production compose)
WEB_PORT=8080

# --- Discord event notifications -----------------------------------------
# Discord: Server Settings → Integrations → Webhooks → New Webhook → pick channel → Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Role pinged with every notification (Developer Mode → right-click role → Copy Role ID). Empty = no ping.
DISCORD_EVENT_ROLE_ID=

# --- Database backups -------------------------------------------------------
# Host folder for backups (relative to docker-compose.yml)
BACKUP_PATH=./backups
BACKUP_INTERVAL_DAYS=7
# How many backups to keep (older ones are deleted)
BACKUP_KEEP=8
