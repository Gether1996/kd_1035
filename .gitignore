# Secrets – never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Django runtime data
# (backend/media and backend/snapshot/db.sqlite3 ARE committed – database sync through git, see .githooks)
backend/data/
backend/staticfiles/
*.sqlite3
*.sqlite3-*
!backend/snapshot/db.sqlite3
backend/snapshot/*.tmp*

# Tooling caches
tools/**/.cache/

# OS / editors
.DS_Store
Thumbs.db
.idea/
tools/screenshots/out/
tools/screenshots/node_modules/
tools/youtube/out/

# Database backups (worker)
backups/
